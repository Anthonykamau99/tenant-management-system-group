<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.tenantmanagementsystem.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_addTenant"
            app:destination="@id/addTenantFragment" />
        <action
            android:id="@+id/action_dashboard_to_viewTenants"
            app:destination="@id/viewTenantsFragment" />
    </fragment>

    <fragment
        android:id="@+id/addTenantFragment"
        android:name="com.example.tenantmanagementsystem.ui.tenants.AddTenantFragment"
        android:label="Add Tenant"
        tools:layout="@layout/fragment_add_tenant" />

    <fragment
        android:id="@+id/viewTenantsFragment"
        android:name="com.example.tenantmanagementsystem.ui.tenants.ViewTenantsFragment"
        android:label="View Tenants"
        tools:layout="@layout/fragment_view_tenants" />

</navigation>
